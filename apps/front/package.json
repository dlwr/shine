{
  "name": "@shine/front",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:prod": "pnpm run build && wrangler deploy --env production --minify",
    "dev": "react-router dev",
    "postinstall": "pnpm run cf-typegen",
    "preview": "pnpm run build && vite preview",
    "typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b --clean && tsc -b"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.7.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "4.131.2"
  }
