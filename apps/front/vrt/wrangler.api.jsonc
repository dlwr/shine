{
  "name": "shine-api-vrt",
  "main": "./api-worker.ts",
  "compatibility_date": "2025-03-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "QUIZ_ANSWER_KEY": "vrt-quiz-answer-key",
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "shine-vrt", "database_id": "vrt"},
  ],
  "kv_namespaces": [{"binding": "CACHE_KV", "id": "vrt"}],
  "ratelimits": [
    {
      "name": "SUGGEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {"limit": 1000, "period": 10},
    },
    {
      "name": "AVAILABILITY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {"limit": 1000, "period": 60},
    },
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {"limit": 1000, "period": 60},
    },
  ],
}
