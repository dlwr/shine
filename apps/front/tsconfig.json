{
  "files": [],
  "references": [
    {"path": "./tsconfig.node.json"},
    {"path": "./tsconfig.cloudflare.json"}
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shine/api/*": ["../api/src/*"],
      "@routes/*": ["./app/routes/*"],
      "@/*": ["./app/*"],
      "@/components/*": ["./app/components/*"],
      "@/lib/*": ["./app/lib/*"],
      "@/hooks/*": ["./app/hooks/*"]
    }
  }
}
