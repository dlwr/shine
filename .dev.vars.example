# Cloudflare D1 (via shine-database-proxy)
D1_PROXY_URL=https://shine-database-proxy.your-account.workers.dev
D1_PROXY_KEY=your-proxy-key

# Movie Data APIs
TMDB_API_KEY=your-tmdb-api-key
TMDB_LEAD_ACCESS_TOKEN=your-tmdb-read-access-token
OMDB_API_KEY=your-omdb-api-key

# Admin Authentication
ADMIN_PASSWORD=your-secure-admin-password
JWT_SECRET=your-jwt-secret-key
